#include "/Engine/Public/Platform.ush"

struct FGPUPVSBox3f
{
	float3 Min;
	float3 Max;
};

struct FGPUPVSBVHNode
{
	float3 BoundsMin;
	uint LeftChildOrFirstTri;
	float3 BoundsMax;
	uint RightChildOrTriCount;
};

StructuredBuffer<FGPUPVSBox3f> InCells;
StructuredBuffer<FGPUPVSBox3f> InMeshes;
StructuredBuffer<FGPUPVSBox3f> InGroups;
StructuredBuffer<uint> InMeshToGroup;
StructuredBuffer<uint> InGroupVisibilityWords;

StructuredBuffer<FGPUPVSBVHNode> InBVHNodes;
StructuredBuffer<uint> InBVHLeafTriIndices;
StructuredBuffer<float3> InVertices;
StructuredBuffer<uint> InIndices;

uint NumCells;
uint NumMeshes;
uint NumGroups;
uint WordsPerCell;
uint GroupWordsPerCell;

uint NumCellSamples;
uint MinMeshSamples;
uint MaxMeshSamples;
uint NumImportanceSamples;

float MeshBoundsScale;
float MaxDistance;
uint EnableStats;

RWStructuredBuffer<uint> OutVisibilityWords;
RWStructuredBuffer<uint> OutStats;

void StatAdd(uint Index, uint Value)
{
	if (EnableStats != 0u)
	{
		InterlockedAdd(OutStats[Index], Value);
	}
}

uint HashUint(uint x)
{
	x ^= x >> 16;
	x *= 0x7feb352d;
	x ^= x >> 15;
	x *= 0x846ca68b;
	x ^= x >> 16;
	return x;
}

float Rand01(inout uint State)
{
	State = HashUint(State);
	return (State & 0x00FFFFFFu) * (1.0f / 16777216.0f);
}

float3 BoxCenter(FGPUPVSBox3f B) { return (B.Min + B.Max) * 0.5f; }
float3 BoxExtent(FGPUPVSBox3f B) { return (B.Max - B.Min) * 0.5f; }

bool RayAABB(float3 O, float3 D, float3 BMin, float3 BMax, float TMax, out float TEnter, out float TExit)
{
	float3 InvD = 1.0f / D;
	float3 T0 = (BMin - O) * InvD;
	float3 T1 = (BMax - O) * InvD;
	float3 TMin3 = min(T0, T1);
	float3 TMax3 = max(T0, T1);
	float TMin = max(TMin3.x, max(TMin3.y, TMin3.z));
	float TMaxLocal = min(TMax3.x, min(TMax3.y, TMax3.z));
	TEnter = TMin;
	TExit = TMaxLocal;
	return (TMaxLocal >= max(TMin, 0.0f)) && (TMin <= TMax);
}

bool RayTri(float3 O, float3 D, float3 V0, float3 V1, float3 V2, out float T)
{
	float3 E1 = V1 - V0;
	float3 E2 = V2 - V0;
	float3 P = cross(D, E2);
	float Det = dot(E1, P);
	if (abs(Det) < 1e-8f)
	{
		T = 0.0f;
		return false;
	}
	float InvDet = 1.0f / Det;
	float3 Tvec = O - V0;
	float U = dot(Tvec, P) * InvDet;
	if (U < 0.0f || U > 1.0f)
	{
		T = 0.0f;
		return false;
	}
	float3 Q = cross(Tvec, E1);
	float V = dot(D, Q) * InvDet;
	if (V < 0.0f || (U + V) > 1.0f)
	{
		T = 0.0f;
		return false;
	}
	float TT = dot(E2, Q) * InvDet;
	if (TT <= 1e-4f)
	{
		T = 0.0f;
		return false;
	}
	T = TT;
	return true;
}

bool TraverseBVHAnyHit(float3 O, float3 D, float TMax, out float HitT)
{
	HitT = TMax;

	uint Stack[64];
	uint StackPtr = 0;
	Stack[StackPtr++] = 0u;

	while (StackPtr > 0)
	{
		uint NodeIndex = Stack[--StackPtr];
		FGPUPVSBVHNode N = InBVHNodes[NodeIndex];

		float TEnter, TExit;
		if (!RayAABB(O, D, N.BoundsMin, N.BoundsMax, TMax, TEnter, TExit))
		{
			continue;
		}

		uint Right = N.RightChildOrTriCount;
		if ((Right & 0x80000000u) != 0u)
		{
			uint FirstTri = N.LeftChildOrFirstTri;
			uint TriCount = (Right & 0x7FFFFFFFu);
			for (uint i = 0; i < TriCount; ++i)
			{
				uint TriIndex = InBVHLeafTriIndices[FirstTri + i];
				uint I0 = InIndices[TriIndex * 3 + 0];
				uint I1 = InIndices[TriIndex * 3 + 1];
				uint I2 = InIndices[TriIndex * 3 + 2];
				float3 V0 = InVertices[I0];
				float3 V1 = InVertices[I1];
				float3 V2 = InVertices[I2];
				float T;
				if (RayTri(O, D, V0, V1, V2, T) && T < TMax)
				{
					HitT = T;
					return true;
				}
			}
		}
		else
		{
			uint LeftChild = N.LeftChildOrFirstTri;
			uint RightChild = Right;
			if (StackPtr + 2u <= 64u)
			{
				Stack[StackPtr++] = RightChild;
				Stack[StackPtr++] = LeftChild;
			}
			else
			{
				return true;
			}
		}
	}

	return false;
}

uint ChooseFaceWeighted(float3 DirToTarget, inout uint Rng)
{
	float3 D = normalize(DirToTarget);
	float3 FaceN[6] = {
		float3( 1, 0, 0), float3(-1, 0, 0),
		float3( 0, 1, 0), float3( 0,-1, 0),
		float3( 0, 0, 1), float3( 0, 0,-1)
	};

	float W[6];
	float Sum = 0.0f;
	[unroll] for (uint i = 0; i < 6; ++i)
	{
		W[i] = max(0.0f, dot(-D, FaceN[i]));
		Sum += W[i];
	}

	if (Sum <= 1e-6f)
	{
		return (uint)floor(Rand01(Rng) * 6.0f);
	}

	float R = Rand01(Rng) * Sum;
	float Acc = 0.0f;
	[unroll] for (uint i = 0; i < 6; ++i)
	{
		Acc += W[i];
		if (R <= Acc)
		{
			return i;
		}
	}
	return 5u;
}

uint ChooseFaceFacing(float3 DirToTarget, inout uint Rng)
{
	float3 D = normalize(DirToTarget);
	float3 FaceN[6] = {
		float3( 1, 0, 0), float3(-1, 0, 0),
		float3( 0, 1, 0), float3( 0,-1, 0),
		float3( 0, 0, 1), float3( 0, 0,-1)
	};

	uint Mask = 0u;
	uint Count = 0u;
	[unroll] for (uint i = 0; i < 6; ++i)
	{
		if (dot(D, FaceN[i]) > 0.0f)
		{
			Mask |= (1u << i);
			Count++;
		}
	}

	if (Count == 0u)
	{
		return (uint)floor(Rand01(Rng) * 6.0f);
	}

	uint Pick = (uint)floor(Rand01(Rng) * (float)Count);
	uint Seen = 0u;
	[unroll] for (uint i = 0; i < 6; ++i)
	{
		if ((Mask & (1u << i)) != 0u)
		{
			if (Seen == Pick) return i;
			Seen++;
		}
	}
	return 0u;
}

float3 SamplePointOnBoxFace(FGPUPVSBox3f B, uint FaceIndex, float U, float V)
{
	float3 Min = B.Min;
	float3 Max = B.Max;

	if (FaceIndex == 0u) return float3(Max.x, lerp(Min.y, Max.y, U), lerp(Min.z, Max.z, V));
	if (FaceIndex == 1u) return float3(Min.x, lerp(Min.y, Max.y, U), lerp(Min.z, Max.z, V));
	if (FaceIndex == 2u) return float3(lerp(Min.x, Max.x, U), Max.y, lerp(Min.z, Max.z, V));
	if (FaceIndex == 3u) return float3(lerp(Min.x, Max.x, U), Min.y, lerp(Min.z, Max.z, V));
	if (FaceIndex == 4u) return float3(lerp(Min.x, Max.x, U), lerp(Min.y, Max.y, V), Max.z);
	return float3(lerp(Min.x, Max.x, U), lerp(Min.y, Max.y, V), Min.z);
}

float3 JitterCone(float3 Dir, float ConeAngleRad, float U1, float U2)
{
	float CosMax = cos(ConeAngleRad);
	float CosTheta = lerp(CosMax, 1.0f, U1);
	float SinTheta = sqrt(max(0.0f, 1.0f - CosTheta * CosTheta));
	float Phi = 6.28318530718f * U2;

	float3 W = normalize(Dir);
	float3 Up = abs(W.z) < 0.999f ? float3(0, 0, 1) : float3(0, 1, 0);
	float3 U = normalize(cross(Up, W));
	float3 V = cross(W, U);
	return normalize(U * (cos(Phi) * SinTheta) + V * (sin(Phi) * SinTheta) + W * CosTheta);
}

bool ComputeBoxVisibility(FGPUPVSBox3f CellB, FGPUPVSBox3f MeshB, inout uint Rng, inout uint LocalRays, out uint ReasonMask)
{
	ReasonMask = 0u;
	float3 CellC = BoxCenter(CellB);
	float3 MeshC = BoxCenter(MeshB);
	float3 ToMesh = MeshC - CellC;
	float Dist = length(ToMesh);
	if (Dist <= 1e-3f) return true;
	if (MaxDistance > 0.0f && Dist > MaxDistance)
	{
		ReasonMask |= 1u;
		return false;
	}

	float3 Ext = BoxExtent(MeshB);
	float MeshSize = length(Ext);
	float SizeRatio = MeshSize / max(1.0f, Dist);
	if (SizeRatio > 1.0f)
	{
		ReasonMask |= 2u;
		return true;
	}

	uint NumMS = (uint)clamp((int)floor(SizeRatio * (float)MaxMeshSamples), (int)MinMeshSamples, (int)MaxMeshSamples);
	float BestHitT = -1.0f;
	float3 BestO = 0;
	float3 BestD = 0;
	float BestLen = 0.0f;

	for (uint CS = 0u; CS < NumCellSamples; ++CS)
	{
		uint CellFace = ChooseFaceWeighted(ToMesh, Rng);
		float3 CellP = SamplePointOnBoxFace(CellB, CellFace, Rand01(Rng), Rand01(Rng));

		for (uint MS = 0u; MS < NumMS; ++MS)
		{
			uint MeshFace = ChooseFaceFacing(CellP - MeshC, Rng);
			float3 MeshP = SamplePointOnBoxFace(MeshB, MeshFace, Rand01(Rng), Rand01(Rng));

			float3 RayV = MeshP - CellP;
			float RayLen = length(RayV);
			if (RayLen <= 1e-3f) return true;

			float3 RayD = RayV / RayLen;
			float TMax = RayLen - 1e-3f;

			float HitT;
			LocalRays++;
			bool bHit = TraverseBVHAnyHit(CellP, RayD, TMax, HitT);
			if (!bHit)
			{
				ReasonMask |= 4u;
				return true;
			}

			if (HitT > BestHitT)
			{
				BestHitT = HitT;
				BestO = CellP;
				BestD = RayD;
				BestLen = TMax;
			}
		}
	}

	if (NumImportanceSamples == 0u) return false;
	if (BestHitT < 0.0f) return false;

	const float ConeAngleRad = 0.034906585f;
	for (uint IS = 0u; IS < NumImportanceSamples; ++IS)
	{
		float3 JDir = JitterCone(BestD, ConeAngleRad, Rand01(Rng), Rand01(Rng));
		float HitT;
		LocalRays++;
		bool bHit = TraverseBVHAnyHit(BestO, JDir, BestLen, HitT);
		if (!bHit)
		{
			ReasonMask |= 8u;
			return true;
		}
	}

	return false;
}

[numthreads(THREADS_X, THREADS_Y, 1)]
void MainGroupCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint GroupIndex = DispatchThreadId.x;
	uint CellIndex = DispatchThreadId.y;
	if (GroupIndex >= NumGroups || CellIndex >= NumCells) return;

	FGPUPVSBox3f CellB = InCells[CellIndex];
	FGPUPVSBox3f GroupB = InGroups[GroupIndex];

	float3 C = BoxCenter(GroupB);
	float3 E = BoxExtent(GroupB) * MeshBoundsScale;
	GroupB.Min = C - E;
	GroupB.Max = C + E;

	uint Seed = HashUint(CellIndex * 73856093u ^ GroupIndex * 19349663u ^ 0xC0FFEE17u);
	uint LocalRays = 0u;
	uint ReasonMask = 0u;
	bool bVisible = ComputeBoxVisibility(CellB, GroupB, Seed, LocalRays, ReasonMask);

	StatAdd(0u, 1u);
	StatAdd(7u, LocalRays);
	if ((ReasonMask & 1u) != 0u) StatAdd(2u, 1u);
	if ((ReasonMask & 2u) != 0u) StatAdd(3u, 1u);
	if ((ReasonMask & 4u) != 0u) StatAdd(5u, 1u);
	if ((ReasonMask & 8u) != 0u) StatAdd(6u, 1u);
	if (!bVisible) return;

	StatAdd(1u, 1u);
	uint WordIndex = CellIndex * WordsPerCell + (GroupIndex >> 5);
	uint Bit = 1u << (GroupIndex & 31u);
	InterlockedOr(OutVisibilityWords[WordIndex], Bit);
}

bool IsGroupVisible(uint CellIndex, uint GroupIndex)
{
	uint WordIndex = CellIndex * GroupWordsPerCell + (GroupIndex >> 5);
	uint Bit = 1u << (GroupIndex & 31u);
	return (InGroupVisibilityWords[WordIndex] & Bit) != 0u;
}

[numthreads(THREADS_X, THREADS_Y, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint MeshIndex = DispatchThreadId.x;
	uint CellIndex = DispatchThreadId.y;
	if (MeshIndex >= NumMeshes || CellIndex >= NumCells) return;

	FGPUPVSBox3f CellB = InCells[CellIndex];
	FGPUPVSBox3f MeshB = InMeshes[MeshIndex];

	float3 C = BoxCenter(MeshB);
	float3 E = BoxExtent(MeshB) * MeshBoundsScale;
	MeshB.Min = C - E;
	MeshB.Max = C + E;

	uint Seed = HashUint(CellIndex * 73856093u ^ MeshIndex * 19349663u ^ 0xA5B35705u);
	uint LocalRays = 0u;
	uint ReasonMask = 0u;
	bool bVisible = ComputeBoxVisibility(CellB, MeshB, Seed, LocalRays, ReasonMask);

	StatAdd(0u, 1u);
	StatAdd(7u, LocalRays);
	if ((ReasonMask & 1u) != 0u) StatAdd(2u, 1u);
	if ((ReasonMask & 2u) != 0u) StatAdd(3u, 1u);
	if ((ReasonMask & 4u) != 0u) StatAdd(5u, 1u);
	if ((ReasonMask & 8u) != 0u) StatAdd(6u, 1u);
	if (!bVisible) return;

	StatAdd(1u, 1u);
	uint WordIndex = CellIndex * WordsPerCell + (MeshIndex >> 5);
	uint Bit = 1u << (MeshIndex & 31u);
	InterlockedOr(OutVisibilityWords[WordIndex], Bit);
}

[numthreads(THREADS_X, THREADS_Y, 1)]
void MainMeshCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint MeshIndex = DispatchThreadId.x;
	uint CellIndex = DispatchThreadId.y;
	if (MeshIndex >= NumMeshes || CellIndex >= NumCells) return;

	uint GroupIndex = InMeshToGroup[MeshIndex];
	if (GroupIndex != 0xFFFFFFFFu && GroupIndex < NumGroups)
	{
		if (!IsGroupVisible(CellIndex, GroupIndex))
		{
			StatAdd(4u, 1u);
			return;
		}
	}

	FGPUPVSBox3f CellB = InCells[CellIndex];
	FGPUPVSBox3f MeshB = InMeshes[MeshIndex];

	float3 C = BoxCenter(MeshB);
	float3 E = BoxExtent(MeshB) * MeshBoundsScale;
	MeshB.Min = C - E;
	MeshB.Max = C + E;

	uint Seed = HashUint(CellIndex * 73856093u ^ MeshIndex * 19349663u ^ 0xA5B35705u);
	uint LocalRays = 0u;
	uint ReasonMask = 0u;
	bool bVisible = ComputeBoxVisibility(CellB, MeshB, Seed, LocalRays, ReasonMask);

	StatAdd(0u, 1u);
	StatAdd(7u, LocalRays);
	if ((ReasonMask & 1u) != 0u) StatAdd(2u, 1u);
	if ((ReasonMask & 2u) != 0u) StatAdd(3u, 1u);
	if ((ReasonMask & 4u) != 0u) StatAdd(5u, 1u);
	if ((ReasonMask & 8u) != 0u) StatAdd(6u, 1u);
	if (!bVisible) return;

	StatAdd(1u, 1u);
	uint WordIndex = CellIndex * WordsPerCell + (MeshIndex >> 5);
	uint Bit = 1u << (MeshIndex & 31u);
	InterlockedOr(OutVisibilityWords[WordIndex], Bit);
}

